#!/usr/bin/env bash
set -euo pipefail
experiment_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
mkdir -p "$experiment_root/.dev/terminal-stack"
go -C "$experiment_root/experiments/terminal-stack" build -o "$experiment_root/.dev/terminal-stack/spike" ./cmd/spike
exec "$experiment_root/.dev/terminal-stack/spike" "$@"
