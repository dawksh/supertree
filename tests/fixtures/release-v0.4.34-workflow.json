{
  "release": "v0.4.34",
  "commit": "82acc14a7e8ea6023f826fca30cb16f98d484d6f",
  "bindings": [
    "bind -n M-w run-shell -b -c '#{pane_current_path}' \"~/.local/bin/st go --popup '#{client_tty}'\"",
    "bind -n M-e run-shell -b \"~/.local/bin/st toggle\"",
    "bind -n M-Tab run-shell -b \"~/.local/bin/st last\"",
    "bind -n M-r run-shell -b -c '#{pane_current_path}' \"~/.local/bin/st roots --popup '#{client_tty}'\"",
    "bind -n M-1 run-shell -b \"~/.local/bin/st window 1\"",
    "bind -n M-2 run-shell -b \"~/.local/bin/st window 2\"",
    "bind -n M-3 run-shell -b \"~/.local/bin/st window 3\"",
    "bind -n M-4 run-shell -b \"~/.local/bin/st window 4\"",
    "bind -n M-5 run-shell -b \"~/.local/bin/st window 5\"",
    "bind -n M-6 run-shell -b \"~/.local/bin/st window 6\"",
    "bind -n M-7 run-shell -b \"~/.local/bin/st window 7\"",
    "bind -n M-8 run-shell -b \"~/.local/bin/st window 8\"",
    "bind -n M-9 run-shell -b \"~/.local/bin/st window 9\"",
    "bind -n M-n next-window",
    "bind -n M-p previous-window",
    "bind -n M-s run-shell -b \"~/.local/bin/st _sidebar-focus\"",
    "bind -n M-B run-shell -b \"~/.local/bin/st _sidebar-toggle\"",
    "bind -n M-h select-pane -L",
    "bind -n M-l select-pane -R",
    "bind -n M-x if-shell -F '#{==:#{@st_sidebar},1}' '' { if-shell -F '#{||:#{@st_home_pane},#{@st_lent_pane}}' { run-shell -b \"~/.local/bin/st _split-return '#{pane_id}'\" } { confirm-before -p \"close pane? (y/n)\" kill-pane } }",
    "bind -n M-v run-shell -b \"~/.local/bin/st split\"",
    "bind -n M-V run-shell -b \"~/.local/bin/st split --vertical\"",
    "bind -n M-j run-shell \"~/.local/bin/st _tree-next\"",
    "bind -n M-k run-shell \"~/.local/bin/st _tree-prev\"",
    "bind -n M-/ display-popup -EE -w 82 -h 30 -T ' Keys ' \"~/.local/bin/st keys --wait\"",
    "bind -n M-q run-shell -b \"~/.local/bin/st leave '#{client_tty}'\"",
    "bind -n M-Q detach-client"
  ],
  "windows": [
    "agent",
    "vim",
    "shell"
  ],
  "harnesses": {
    "claude": {
      "command": "claude",
      "start": [],
      "resume": [
        "--continue"
      ]
    },
    "codex": {
      "command": "codex",
      "start": [
        "--no-daemon"
      ],
      "resume": [
        "--no-daemon",
        "resume",
        "--last"
      ]
    },
    "openrouter": {
      "command": "opencode",
      "start": [],
      "resume": [
        "--continue"
      ]
    }
  }
