#!/usr/bin/env bash
# Run this checkout in a local sandbox; never install or edit user dotfiles.
set -euo pipefail

dev_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
dev_dir="$dev_root/.dev"
dev_bin="$dev_dir/bin"

dev_fail() { printf 'dev: %s\n' "$*" >&2; exit 1; }
die() { dev_fail "$@"; }
dev_build() {
  command -v go >/dev/null || dev_fail 'Go 1.24 or newer is required'
  go -C "$dev_root" build -o "$dev_root/bin/st-next" ./cmd/st-next
}

dev_write() {
  local target=$1 mode=$2 staged
  staged=$(mktemp "$target.XXXXXX")
  cat > "$staged"
  chmod "$mode" "$staged"
  # Background jobs can be executing these files while the launcher refreshes them.
  if cmp -s "$staged" "$target"; then rm "$staged"
  else mv -f "$staged" "$target"; fi
}

# A binding passes through tmux's quoted config, format expansion, and a shell.
# Match the installer's quoting so checkout paths with spaces, # or quotes work.
dev_tmux_shell_word() {
  local q="'" escaped_q="'\\''" word
  word="'${1//$q/$escaped_q}'"
  word=${word//\\/\\\\}
  word=${word//\"/\\\"}
  word=${word//\$/\\\$}
  printf '%s' "${word//#/##}"
}

# Drop sandbox wrappers before finding real tools or running the test suite.
dev_clean_path=''
IFS=: read -r -a dev_path_parts <<< "$PATH"
for dev_path_part in "${dev_path_parts[@]}"; do
  [ "$dev_path_part" != "$dev_bin" ] || continue
  [ -z "${ST_DEV_ROOT:-}" ] || [ "$dev_path_part" != "$ST_DEV_ROOT/.dev/bin" ] || continue
  if [ -z "$dev_clean_path" ]; then dev_clean_path=$dev_path_part
  else dev_clean_path="$dev_clean_path:$dev_path_part"; fi
done
export PATH=$dev_clean_path

case ${1:-} in
  help|-h|--help)
    cat <<'HELP'
Usage: ./dev [st arguments]

  ./dev                          rebuild and reopen the last local worktree
  ./dev open                     open this checkout with agent, Vim and shell
  ./dev new <branch>             create a worktree using the usual flow
  ./dev control                  optional workspace controls (popup inside tmux)
  ./dev next inspect --json       build and inspect the sandbox
  ./dev next commands --json      build and discover commands
  ./dev next daemon start         start the isolated persistent core
  ./dev next events --json        watch sandbox workspace changes
  ./dev build                    rebuild the Go client only
  ./dev test                     run Go checks and the shell suite
  ./dev package [directory]      build release assets locally; never publish
  ./dev tmux <arguments>          control the sandbox's tmux server
  ./dev stop                     stop sandbox sessions; keep state and worktrees

Start with ./dev open. Option-1/2/3 select agent/Vim/shell; Option-w switches
worktrees and Option-v opens the usual split picker. Inside a local shell,
st uses this checkout. Run st control to try the new controls; q returns to work.

Config, state and worktrees live in .dev/ in this checkout. Edit .dev/config
to customize the usual agent/Vim/shell layout. No installation or symlinks needed.
HELP
    exit 0;;
  build)
    [ "$#" -eq 1 ] || dev_fail 'usage: ./dev build'
    dev_build
    exit;;
  package)
    [ "$#" -le 2 ] || dev_fail 'usage: ./dev package [directory]'
    exec bash "$dev_root/scripts/package-release.sh" "${2:-$dev_dir/releases}";;
  test)
    [ "$#" -eq 1 ] || dev_fail 'usage: ./dev test'
    exec bash "$dev_root/scripts/test-local.sh";;
esac

# The path hash separates checkouts; /tmp keeps Unix socket paths short on macOS.
# Only function definitions are loaded from the existing identity module.
. "$dev_root/bin/st-lib/10-identity.sh"
dev_id=$(identity_hash "$dev_root")
dev_socket_dir="/tmp/supertree-dev-$(id -u)"
dev_socket="$dev_socket_dir/${dev_id:0:16}.sock"
dev_core_id=$(identity_hash "$dev_dir/state")
dev_core_socket="/tmp/supertree-next-$(id -u)/$dev_core_id.sock"
dev_real_tmux=$(command -v tmux || true)

if [ "${1:-}" = stop ]; then
  [ "$#" -eq 1 ] || dev_fail 'usage: ./dev stop'
  if [ -S "$dev_core_socket" ]; then
    [ -x "$dev_root/bin/st-next" ] || dev_fail 'build the Go client before stopping the local core'
    ST_STATE="$dev_dir/state" ST_WORKTREE_ROOT="$dev_dir/worktrees" \
      ST_NEXT_SOCKET="$dev_core_socket" ST_NEXT_TMUX_SOCKET="$dev_socket" \
      "$dev_root/bin/st-next" daemon stop
  fi
  [ -n "$dev_real_tmux" ] || dev_fail 'tmux is required'
  if "$dev_real_tmux" -N -S "$dev_socket" has-session 2>/dev/null; then
    "$dev_real_tmux" -S "$dev_socket" kill-server
    printf 'Stopped local sessions; .dev/ state and worktrees kept.\n'
  else
    printf 'Local tmux server is not running.\n'
  fi
  exit
fi

dev_internal=0
if [ "${1:-}" = _run ]; then
  dev_internal=1
  shift
else
  [ -n "$dev_real_tmux" ] || dev_fail 'tmux is required for the local sandbox'
  case ${1:-} in tmux) ;; *) dev_build;; esac
  mkdir -p "$dev_bin" "$dev_dir/state" "$dev_dir/worktrees" "$dev_socket_dir"
  [ -O "$dev_socket_dir" ] && [ ! -L "$dev_socket_dir" ] || dev_fail 'local socket directory is not owned by this user'
  chmod 700 "$dev_socket_dir"
  if [ ! -e "$dev_dir/config" ]; then
    {
      printf '# Local development config; sourced as shell by st.\n'
      printf "ST_WINDOWS='agent vim shell'\nST_HARNESS=codex\nST_SIDEBAR=1\nST_NOTIFY=0\n"
      printf 'ST_AGENT_MODE=terminal\n'
      printf 'ST_SHELL=%q\n' "$dev_bin/dev-shell"
    } > "$dev_dir/config"
  fi
  # Real wrapper scripts keep background jobs pinned to this checkout, even
  # when an installed st or tmux comes earlier in the user's normal PATH.
  {
    printf '#!/usr/bin/env bash\nexec %q _run "$@"\n' "$dev_root/dev"
  } | dev_write "$dev_bin/st" 755
  {
    printf '#!/usr/bin/env bash\nexec %q -S %q -f %q "$@"\n' "$dev_real_tmux" "$dev_socket" "$dev_dir/tmux.conf"
  } | dev_write "$dev_bin/tmux" 755
  dev_write "$dev_bin/dev-shell" 755 <<'SHELL'
#!/usr/bin/env bash
# Keep the sandbox PATH instead of loading login scripts from the installed setup.
[ "${1:-}" != -l ] || shift
export PS1='[supertree dev] \w \$ '
export BASH_SILENCE_DEPRECATION_WARNING=1
exec /bin/bash --noprofile --norc "$@"
SHELL
  # Shell startup files and old server environments can change PATH. Every
  # shortcut must call this checkout's wrapper by its absolute path.
  dev_st_word=$(dev_tmux_shell_word "$dev_bin/st" | sed 's/[\\&|]/\\&/g')
  sed "s|~/.local/bin/st|$dev_st_word|g" "$dev_root/tmux/supertree.conf" | dev_write "$dev_dir/tmux.conf" 600
fi

export ST_DEV_ROOT=$dev_root
export ST_STATE="$dev_dir/state" ST_CONFIG="$dev_dir/config" ST_CONFDIR="$dev_dir"
export ST_WORKTREE_ROOT="$dev_dir/worktrees" ST_NEXT_TMUX_SOCKET=$dev_socket
unset ST_NEXT_SOCKET
export PATH="$dev_bin:$PATH"
# Use the sandbox config rather than an installed agent/layout inherited from tmux.
unset ST_WINDOWS ST_HARNESS ST_HARNESS_COMMAND ST_HARNESS_RESUME_COMMAND ST_SHELL ST_AGENT_MODE ST_AGENT_TOOLS
case ${TMUX:-} in "$dev_socket,"*) ;; *) unset TMUX TMUX_PANE;; esac

if [ "$dev_internal" = 0 ]; then
  if "$dev_bin/tmux" -N has-session 2>/dev/null; then
    "$dev_bin/tmux" source-file "$dev_dir/tmux.conf"
    case ${1:-} in ''|open|new|go|resume|home|control) "$dev_bin/st" _dev-style;; esac
  fi
  if [ "${1:-}" = tmux ]; then
    shift
    exec "$dev_bin/tmux" "$@"
  fi
fi
exec "$dev_root/bin/st" "$@"
