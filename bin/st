#!/usr/bin/env bash
# supertree: git worktree + tmux + coding-agent harness
set -euo pipefail

ST_VERSION='dev'

# tmux may launch this outside an interactive shell
PATH="$HOME/.local/bin:$HOME/.opencode/bin:/opt/homebrew/bin:$PATH"

ST_WORKTREE_ROOT="${ST_WORKTREE_ROOT:-$HOME/projects/.worktrees}"
ST_STATE="${ST_STATE:-$HOME/.local/state/supertree}"
ST_REPOS="$ST_STATE/repos"
ST_CONFIG_FROM_ENV=${ST_CONFIG:-}
ST_CONFIG="${ST_CONFIG:-${ST_CONFDIR:-$HOME/.config/supertree}/config}"

# Config is shell syntax, like .supertree. Environment variables win so a
# one-off `ST_HARNESS=codex st new ...` does what it says.
_env_harness=${ST_HARNESS:-}
_env_harness_command=${ST_HARNESS_COMMAND:-}
_env_harness_resume_command=${ST_HARNESS_RESUME_COMMAND:-}
_env_windows_set=${ST_WINDOWS+x}
_env_windows=${ST_WINDOWS:-}
# A config whose last line is a false test (`[ -n "$X" ] && ...`) must not
# abort every st call, and bash 3.2 ignores `|| true` inside sourced files.
if [ -f "$ST_CONFIG" ]; then
  set +e
  # shellcheck disable=SC1090
  . "$ST_CONFIG"
  set -e
fi
[ -n "$_env_harness" ] && ST_HARNESS=$_env_harness
[ -n "$_env_harness_command" ] && ST_HARNESS_COMMAND=$_env_harness_command
[ -n "$_env_harness_resume_command" ] && ST_HARNESS_RESUME_COMMAND=$_env_harness_resume_command
[ "$_env_windows_set" = x ] && ST_WINDOWS=$_env_windows
ST_HARNESS=${ST_HARNESS:-claude}
ST_HARNESS_COMMAND=${ST_HARNESS_COMMAND:-}
ST_HARNESS_RESUME_COMMAND=${ST_HARNESS_RESUME_COMMAND:-}
ST_WINDOWS=${ST_WINDOWS-'agent vim shell'}


# Follow source-install symlinks so the command finds modules beside bin/st.
st_source=$0
case $st_source in */*) ;; *) st_source=$(command -v -- "$st_source");; esac
while [ -L "$st_source" ]; do
  st_link=$(readlink "$st_source")
  case $st_link in
    /*) st_source=$st_link;;
    *) st_source=$(dirname "$st_source")/$st_link;;
  esac
done
st_lib_dir=$(cd "$(dirname "$st_source")" && pwd)/st-lib
if [ "$ST_VERSION" != dev ]; then
  st_lib_dir="$st_lib_dir-$ST_VERSION"
fi
[ -f "$st_lib_dir/00-core.sh" ] || { printf 'st: missing modules in %s\n' "$st_lib_dir" >&2; exit 1; }
# shellcheck disable=SC1090
. "$st_lib_dir/00-core.sh"

# Slot 0 is a placeholder: bash 3.2 treats an empty array as unset under set -u.
ST_COMMAND_NAMES=('')
ST_COMMAND_HANDLERS=('')
ST_COMMAND_HELP=('')
ST_COMMAND_USAGE=('')

st_register_command() {
  local name=$1 handler=$2 description=${3:-} usage=${4:-$1} existing
  case $name in ''|*[!A-Za-z0-9_-]*) die "invalid module command: $name";; esac
  declare -F "$handler" >/dev/null || die "missing handler $handler for command $name"
  for existing in "${ST_COMMAND_NAMES[@]}"; do
    [ "$existing" != "$name" ] || die "duplicate module command: $name"
  done
  ST_COMMAND_NAMES+=("$name")
  ST_COMMAND_HANDLERS+=("$handler")
  ST_COMMAND_HELP+=("$description")
  ST_COMMAND_USAGE+=("$usage")
}

# Load each module once. Modules register their own commands at the end.
for st_module in "$st_lib_dir"/*.sh; do
  [ -f "$st_module" ] || continue
  [ "$st_module" != "$st_lib_dir/00-core.sh" ] || continue
  # shellcheck disable=SC1090
  . "$st_module"
done

usage() {
  local i
  printf 'st — supertree: worktree + tmux + coding-agent harness\n\n'
  for ((i=0; i<${#ST_COMMAND_NAMES[@]}; i++)); do
    [ -n "${ST_COMMAND_HELP[i]}" ] || continue
    printf '  %-43s %s\n' "${ST_COMMAND_USAGE[i]}" "${ST_COMMAND_HELP[i]}"
  done
  print_keys
}

print_keys() {
  cat <<'KEYS'
keys (inside tmux; defaults, rebind with ST_KEY_* in the config)
  M-w   tree picker          M-e   toggle first <-> second configured window
  M-Tab switch to the previous tree
  M-r         pick a known repo and create a tree in it
  M-1 … M-9   select configured window (tab) by position
  M-n / M-p   next / previous tab
  M-j / M-k   next / previous open tree
  M-v         split: another copy of this tab's program side by side
  M-h / M-l   move to the pane on the left / right
  M-x         close the focused pane (asks first)
  M-s         focus the tree sidebar   M-B   hide/show the sidebar
  M-q         back to the session st was opened from
  M-Q         leave tmux; keep the tree session running
  M-/         show these keys

tree picker
  Enter  open tree           Ctrl-D  delete tree

sidebar
  Enter / l   open tree      j / k   move      g / G   first / last
  d           delete tree    Ctrl-R  reload
  Esc / h / q back to the tab
KEYS
}

cmd_keys() {
  print_keys
  [ "${1:-}" = --wait ] || return 0
  printf '\npress any key to close' >&2
  read -rsn1 _ || true
}
st_register_command 'keys' cmd_keys 'show the tmux key bindings'

st_dispatch() {
  local name=${1:-} i
  case $name in
    '') st_dispatch open; return;;
    -h|--help|help) usage; return;;
    --version|-V) printf 'st %s\n' "$ST_VERSION"; return;;
  esac
  shift
  for ((i=0; i<${#ST_COMMAND_NAMES[@]}; i++)); do
    if [ "${ST_COMMAND_NAMES[i]}" = "$name" ]; then
      "${ST_COMMAND_HANDLERS[i]}" "$@"
      return
    fi
  done
  die "unknown command: $name (try: st help)"
}

st_dispatch "$@"
