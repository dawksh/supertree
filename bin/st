#!/usr/bin/env bash
# supertree: git worktree + tmux + coding-agent harness
set -euo pipefail

ST_VERSION='dev'

# tmux can outlive a test or another shell with a different HOME. Installed
# bindings invoke ~/.local/bin/st by absolute path, so recover that user's home
# when the inherited HOME has no Supertree config of its own.
case $0 in
  /*/.local/bin/st)
    st_command_home=${0%/.local/bin/st}
    if [ ! -f "$HOME/.config/supertree/config" ] &&
       [ -f "$st_command_home/.config/supertree/config" ]; then
      HOME=$st_command_home
      export HOME
    fi;;
esac

# A long-lived tmux server may still export a config path from a deleted test
# fixture. In that case use the installed user's config and matching state.
st_default_config=${ST_CONFDIR:-$HOME/.config/supertree}/config
if [ -n "${ST_CONFIG:-}" ] && [ ! -f "$ST_CONFIG" ] &&
   [ -f "$st_default_config" ]; then
  st_stale_dir=${ST_CONFIG%/*}
  unset ST_CONFIG
  case ${ST_STATE:-} in "$st_stale_dir"/*) unset ST_STATE;; esac
  case ${ST_WORKTREE_ROOT:-} in "$st_stale_dir"/*) unset ST_WORKTREE_ROOT;; esac
fi

# tmux may launch this outside an interactive shell
PATH="$HOME/.local/bin:$HOME/.opencode/bin:/opt/homebrew/bin:$PATH"

# Repair must be available before config and modules are loaded: either may be
# damaged on an installed machine. Reuse the verified release installer so the
# command, modules, generated bindings, and tmux source line are restored as a set.
if [ "${1:-}" = repair ]; then
  [ "$#" -eq 1 ] || { printf 'st: usage: st repair\n' >&2; exit 1; }
  [ "$ST_VERSION" != dev ] || {
    printf 'st: source install detected; restore the checkout with git and reload its tmux config\n' >&2
    exit 1
  }
  for st_tool in curl tar; do
    command -v "$st_tool" >/dev/null 2>&1 || {
      printf 'st: %s is required to repair st\n' "$st_tool" >&2; exit 1;
    }
  done
  command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 || {
    printf 'st: sha256sum or shasum is required to repair st\n' >&2; exit 1
  }
  st_self=$0
  case $st_self in */*) ;; *) st_self=$(command -v -- "$st_self");; esac
  [ ! -L "$st_self" ] || {
    printf 'st: source install detected; restore the checkout with git\n' >&2; exit 1
  }
  st_prefix=$(cd "$(dirname "$st_self")" && pwd)
  [ -w "$st_prefix" ] || { printf 'st: cannot repair %s (directory is not writable)\n' "$st_self" >&2; exit 1; }
  st_manifest="$st_self.install"
  st_confdir=${ST_CONFDIR:-}
  [ -n "$st_confdir" ] || [ ! -f "$st_manifest" ] || st_confdir=$(sed -n '1p' "$st_manifest")
  st_confdir=${st_confdir:-$HOME/.config/supertree}
  st_tmux_conf=${TMUX_CONF:-}
  [ -n "$st_tmux_conf" ] || [ ! -f "$st_manifest" ] || st_tmux_conf=$(sed -n '2p' "$st_manifest")
  st_tmux_conf=${st_tmux_conf:-$HOME/.tmux.conf}
  st_release_root=${ST_RELEASE_ROOT:-https://github.com/dawksh/supertree}
  st_tmp=$(mktemp -d)
  trap 'rm -rf "$st_tmp"' EXIT
  printf 'st: downloading and verifying %s for repair...\n' "$ST_VERSION"
  curl -fsSL --connect-timeout 10 --max-time 60 \
    "$st_release_root/releases/download/$ST_VERSION/install.sh" -o "$st_tmp/install.sh" ||
    { printf 'st: could not download installer for %s\n' "$ST_VERSION" >&2; exit 1; }
  curl -fsSL --connect-timeout 10 --max-time 60 \
    "$st_release_root/releases/download/$ST_VERSION/SHA256SUMS" -o "$st_tmp/SHA256SUMS" ||
    { printf 'st: could not download checksums for %s\n' "$ST_VERSION" >&2; exit 1; }
  st_expected=$(awk '$2 == "install.sh" { print $1 }' "$st_tmp/SHA256SUMS")
  if command -v sha256sum >/dev/null 2>&1; then st_actual=$(sha256sum "$st_tmp/install.sh")
  else st_actual=$(shasum -a 256 "$st_tmp/install.sh"); fi
  [ -n "$st_expected" ] && [ "$st_expected" = "${st_actual%% *}" ] || {
    printf 'st: installer checksum mismatch; nothing was changed\n' >&2; exit 1
  }
  bash -n "$st_tmp/install.sh" || { printf 'st: downloaded installer has invalid syntax\n' >&2; exit 1; }
  (
    unset ST_HARNESS ST_WINDOWS ST_CONFIG
    ST_VERSION=$ST_VERSION ST_PREFIX=$st_prefix ST_CONFDIR=$st_confdir \
      TMUX_CONF=$st_tmux_conf ST_YES=1 ST_UPDATE=1 ST_REPAIR=1 \
      bash "$st_tmp/install.sh"
  ) || { printf 'st: repair failed\n' >&2; exit 1; }
  printf 'st: repaired %s; run st doctor to check dependencies\n' "$ST_VERSION"
  exit 0
fi

ST_WORKTREE_ROOT="${ST_WORKTREE_ROOT:-$HOME/projects/.worktrees}"
ST_STATE="${ST_STATE:-$HOME/.local/state/supertree}"
ST_REPOS="$ST_STATE/repos"
ST_CONFIG_FROM_ENV=${ST_CONFIG:-}
ST_CONFIG="${ST_CONFIG:-${ST_CONFDIR:-$HOME/.config/supertree}/config}"

# Config is shell syntax, like .supertree. Environment variables win so a
# one-off `ST_HARNESS=codex st new ...` does what it says.
_env_harness=${ST_HARNESS:-}
_env_harness_command=${ST_HARNESS_COMMAND:-}
_env_harness_resume_command=${ST_HARNESS_RESUME_COMMAND:-}
_env_windows_set=${ST_WINDOWS+x}
_env_windows=${ST_WINDOWS:-}
# A config whose last line is a false test (`[ -n "$X" ] && ...`) must not
# abort every st call, and bash 3.2 ignores `|| true` inside sourced files.
if [ -f "$ST_CONFIG" ]; then
  set +e
  # shellcheck disable=SC1090
  . "$ST_CONFIG"
  set -e
fi
[ -n "$_env_harness" ] && ST_HARNESS=$_env_harness
[ -n "$_env_harness_command" ] && ST_HARNESS_COMMAND=$_env_harness_command
[ -n "$_env_harness_resume_command" ] && ST_HARNESS_RESUME_COMMAND=$_env_harness_resume_command
[ "$_env_windows_set" = x ] && ST_WINDOWS=$_env_windows
ST_HARNESS=${ST_HARNESS:-claude}
ST_HARNESS_COMMAND=${ST_HARNESS_COMMAND:-}
ST_HARNESS_RESUME_COMMAND=${ST_HARNESS_RESUME_COMMAND:-}
ST_WINDOWS=${ST_WINDOWS-'agent vim shell'}

# Keep NO_COLOR for st's own UI. session_environment and shell_command remove it
# from tmux panes so agents still use the terminal's colors.

# Follow source-install symlinks so the command finds modules beside bin/st.
st_source=$0
case $st_source in */*) ;; *) st_source=$(command -v -- "$st_source");; esac
while [ -L "$st_source" ]; do
  st_link=$(readlink "$st_source")
  case $st_link in
    /*) st_source=$st_link;;
    *) st_source=${st_source%/*}/$st_link;;
  esac
done
st_bin_dir=${st_source%/*}
# Runs on every keypress: only fork cd/pwd when the path is relative or not already clean.
case $st_bin_dir in
  '') st_bin_dir=/;;
  /*) case $st_bin_dir/ in *//*|*/./*|*/../*) st_bin_dir=$(cd "$st_bin_dir" && pwd);; esac;;
  *) st_bin_dir=$(cd "$st_bin_dir" && pwd);;
esac
st_lib_dir=$st_bin_dir/st-lib
if [ "$ST_VERSION" != dev ]; then
  st_lib_dir="$st_lib_dir-$ST_VERSION"
fi
[ -f "$st_lib_dir/00-core.sh" ] || { printf 'st: missing modules in %s\n' "$st_lib_dir" >&2; exit 1; }
# shellcheck disable=SC1090
. "$st_lib_dir/00-core.sh"

# Slot 0 is a placeholder: bash 3.2 treats an empty array as unset under set -u.
ST_COMMAND_NAMES=('')
ST_COMMAND_HANDLERS=('')
ST_COMMAND_HELP=('')
ST_COMMAND_USAGE=('')

st_register_command() {
  local name=$1 handler=$2 description=${3:-} usage=${4:-$1} existing
  case $name in ''|*[!A-Za-z0-9_-]*) die "invalid module command: $name";; esac
  declare -F "$handler" >/dev/null || die "missing handler $handler for command $name"
  for existing in "${ST_COMMAND_NAMES[@]}"; do
    [ "$existing" != "$name" ] || die "duplicate module command: $name"
  done
  ST_COMMAND_NAMES+=("$name")
  ST_COMMAND_HANDLERS+=("$handler")
  ST_COMMAND_HELP+=("$description")
  ST_COMMAND_USAGE+=("$usage")
}

# Load each module once. Modules register their own commands at the end.
for st_module in "$st_lib_dir"/*.sh; do
  [ -f "$st_module" ] || continue
  [ "$st_module" != "$st_lib_dir/00-core.sh" ] || continue
  # shellcheck disable=SC1090
  . "$st_module"
done

# Commands a module adds without a group here land under "more".
ST_HELP_GROUPS='trees:open go resume new roots ls status last split home down rm remove
setup:config trust doctor keys update repair version uninstall'

usage() {
  local i group title names name a='' b='' r='' shown=' '
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then a=$'\033[36m' b=$'\033[1m' r=$'\033[0m'; fi
  printf '%sst%s — supertree: worktree + tmux + coding-agent harness\n' "$b" "$r"
  while IFS=: read -r title names; do
    printf '\n%s%s%s\n' "$b" "$title" "$r"
    for name in $names; do
      if [ "$name" = repair ]; then
        printf '  %s%-43s%s %s\n' "$a" repair "$r" 'restore this release and reload tmux bindings'
        continue
      fi
      for ((i=0; i<${#ST_COMMAND_NAMES[@]}; i++)); do
        [ "${ST_COMMAND_NAMES[i]}" = "$name" ] && [ -n "${ST_COMMAND_HELP[i]}" ] || continue
        printf '  %s%-43s%s %s\n' "$a" "${ST_COMMAND_USAGE[i]}" "$r" "${ST_COMMAND_HELP[i]}"
      done
      shown="$shown$name "
    done
  done <<< "$ST_HELP_GROUPS"
  group=''
  for ((i=0; i<${#ST_COMMAND_NAMES[@]}; i++)); do
    [ -n "${ST_COMMAND_HELP[i]}" ] || continue
    case $shown in *" ${ST_COMMAND_NAMES[i]} "*) continue;; esac
    [ -n "$group" ] || { printf '\n%smore%s\n' "$b" "$r"; group=1; }
    printf '  %s%-43s%s %s\n' "$a" "${ST_COMMAND_USAGE[i]}" "$r" "${ST_COMMAND_HELP[i]}"
  done
  printf '\n'
  print_keys
}

print_keys() {
  cat <<'KEYS'
keys (inside tmux; defaults, rebind with ST_KEY_* in the config)
  M-w   tree picker          M-e   toggle first <-> second configured window
  M-Tab switch to the previous tree
  M-r         pick a known repo and create a tree in it
  M-1 … M-9   select configured window (tab) by position
  M-n / M-p   next / previous tab
  M-j / M-k   next / previous open tree
  M-v         split this tab side by side
  M-V         split this tab top and bottom
  M-h / M-l   move to the pane on the left / right
  M-x         close the focused pane (asks first)
  M-s         focus the tree sidebar   M-B   hide/show the sidebar
  M-q         leave tmux; keep the tree running
  M-Q         leave tmux; keep the tree session running
  M-/         show these keys

tree picker
  Enter  open tree           Ctrl-N  new tree       Ctrl-D  delete tree
  Ctrl-R pick a repo         Ctrl-/  preview        Esc     close

sidebar
  Enter / l   open tree      j / k   move      g / G   first / last
  n           new branch     d       delete tree    Ctrl-R  reload
  Esc / h / q back to the tab
KEYS
}

cmd_keys() {
  print_keys
  [ "${1:-}" = --wait ] || return 0
  printf '\npress any key to close' >&2
  read -rsn1 _ || true
}
st_register_command 'keys' cmd_keys 'show the tmux key bindings'

st_dispatch() {
  local name=${1:-} i
  case $name in
    '') st_dispatch start; return;;
    -h|--help|help) usage; return;;
    --version|-V) printf 'st %s\n' "$ST_VERSION"; return;;
  esac
  shift
  for ((i=0; i<${#ST_COMMAND_NAMES[@]}; i++)); do
    if [ "${ST_COMMAND_NAMES[i]}" = "$name" ]; then
      "${ST_COMMAND_HANDLERS[i]}" "$@"
      return
    fi
  done
  die "unknown command: $name (try: st help)"
}

st_dispatch "$@"
